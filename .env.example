# Optional post-run AI summaries (one request after each completed run).
# Get a key from https://console.groq.com/keys and replace the placeholder locally.
# Keep your real key in .env only; do not commit it or paste it into chat.
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-20b
# Optional: defaults to Groq's OpenAI-compatible endpoint when GROQ_API_KEY is set.
# AI_BASE_URL=https://api.groq.com/openai/v1
